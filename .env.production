# Public, non-secret PRODUCTION web configuration for app.myinterviewcopilot.com / myinterviewcopilot.com.
# Built with: vite build  (default mode)
# The Firebase web API key is a public project identifier, not a credential:
# https://firebase.google.com/docs/projects/api-keys
VITE_API_URL=https://copilot-api.myinterviewcopilot.com
VITE_API_BASE_URL=https://copilot-api.myinterviewcopilot.com/api/admin

# Production uses a DIFFERENT Firebase project from staging (copilotiq-prod vs
# ai-communication-copilot-7f9c0). It must match FIREBASE_PROJECT_ID on the
# production ECS task, or the ID token's aud/iss will not match and every
# Google sign-in returns 401.
VITE_FIREBASE_API_KEY=AIzaSyB8AFnyC69p7SzDK41se0X1yh7WuMkEKik
VITE_FIREBASE_AUTH_DOMAIN=copilotiq-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=copilotiq-prod
VITE_FIREBASE_APP_ID=1:1084537872862:web:cbe1a3bc8c2e67bb5e3d4f
