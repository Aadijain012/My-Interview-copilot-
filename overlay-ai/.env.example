# Deepgram API key for real-time speech-to-text (required for transcription)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Speech-to-Text API key
GOOGLE_SPEECH_KEY=your_google_speech_key_here

# Groq API key (for fast Llama model answer generation)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API key (optional - for AI answer generation)
OPENAI_API_KEY=your_openai_api_key_here

# Set to 1 to log audio buffer and transcription debug info
# DEBUG_AUDIO=1
