VITE_FIREBASE_AUTH_DOMAIN=ai-communication-copilot-7f9c0.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-communication-copilot-7f9c0
VITE_FIREBASE_APP_ID=1:219861055602:web:605c359a49063baea96aeb
