# Public, non-secret STAGING web configuration for staging.myinterviewcopilot.com.
# Built with: vite build --mode staging
# The Firebase web API key is a public project identifier, not a credential:
# https://firebase.google.com/docs/projects/api-keys
VITE_API_URL=https://copilotiq-api.myinterviewcopilot.com
VITE_API_BASE_URL=https://copilotiq-api.myinterviewcopilot.com/api/admin

# Must be the SAME Firebase project the backend verifies tokens against
